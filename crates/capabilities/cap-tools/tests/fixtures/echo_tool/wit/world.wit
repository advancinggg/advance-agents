package advance:runtime@0.1.0;

/// Tool WASM component contract (CONTRACT-163), mirroring the host's
/// `advance:runtime/tool-exports@0.1.0` interface. `method-info` is inlined
/// here (rather than `use agent-tools.{method-info}`) so the produced
/// component has ZERO imports and instantiates against any WASI linker —
/// the host dispatches `describe`/`execute` dynamically (Val-based), so only
/// the structural record shape matters, not which interface defines it.
interface tool-exports {
    record method-info {
        name: string,
        description: option<string>,
        input-schema: option<string>,
        output-schema: option<string>,
        idempotent: option<bool>,
    }

    record tool-description {
        description: string,
        methods: list<method-info>,
    }

    describe: func() -> tool-description;
    execute: func(method: string, params: list<u8>) -> result<list<u8>, string>;
}

/// Fixture world: exports `tool-exports`, imports nothing.
world echo-tool {
    export tool-exports;
}
