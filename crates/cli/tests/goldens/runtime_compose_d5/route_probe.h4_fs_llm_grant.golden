# MODULE-001-T111 (2) route probes through `advance start` on H4 (capabilities: fs, llm, grant; deployed driver; no git repository)
# native client: loopback, no Origin, x-advance-api-version: 2026-09-17, bearer session;
# GET with no query; POST with body {} (+ idempotency-key for mutations); path params = "golden-probe-id"
# <METHOD> <route> -> <status> data {sorted top-level keys of data: JSON type} | error <code> "<message>"
== session
POST /client/session/login -> 200 data {csrf_token: null, expires_at: number, platform: string, principal: object, scopes: array, session_id: string, token: string}
== GET routes
GET /client/agent-templates -> 200 data {templates: array}
GET /client/agents -> 200 data {agents: array}
GET /client/agents/{agent_id} -> 404 error not_found "resource not found"
GET /client/costs/agents -> 200 data {agents: array, window: object}
GET /client/costs/agents/{agent_id} -> 200 data {agent_id: string, by_provider: array, totals: object, window: object}
GET /client/costs/providers -> 200 data {providers: array, window: object}
GET /client/costs/providers/{provider_id} -> 200 data {by_agent: array, provider_id: string, totals: object, window: object}
GET /client/entities/{agent_id}/{entity_id} -> 400 error invalid_request "invalid entity id"
GET /client/events -> 503 error module_unavailable "event provider not wired"
GET /client/events/stream -> 503 error module_unavailable "event provider not wired"
GET /client/grants/pending -> 503 error module_unavailable "provider not wired"
GET /client/health -> 200 data {api_version: string, status: string}
GET /client/llm/deltas/stream -> 200 data {subscribed: bool}
GET /client/messages/{message_id} -> 404 error not_found "resource not found"
GET /client/packs -> 200 data {packs: array}
GET /client/packs/{pack_id} -> 400 error invalid_request "pack id must be name@version"
GET /client/providers -> 200 data {providers: array}
GET /client/providers/{provider_id} -> 404 error not_found "resource not found"
GET /client/providers/{provider_id}/sign-in -> 404 error not_found "resource not found"
GET /client/providers/{provider_id}/usage -> 404 error not_found "resource not found"
GET /client/runs -> 200 data {runs: array}
GET /client/runs/tree -> 200 data {nodes: array}
GET /client/runs/{run_id}/history -> 503 error module_unavailable "provider not wired"
GET /client/schema -> 503 error module_unavailable "provider not wired"
GET /client/secrets/mode -> 200 data {master_key_source: string, mode: string, namespace: string, platform_supported: bool, synchronizable: bool}
GET /client/tasks/{task_id}/history -> 503 error module_unavailable "provider not wired"
GET /client/tools -> 503 error module_unavailable "provider not wired"
== POST reads
POST /client/entities:query -> 400 error invalid_request "invalid entity request body"
== POST mutations
POST /client/agents -> 400 error invalid_request "invalid agent request body"
POST /client/agents/{agent_id}:delete -> 404 error not_found "resource not found"
POST /client/agents/{agent_id}:update -> 400 error invalid_request "empty agent update"
POST /client/entities/{entity_id}:apply -> 400 error invalid_request "invalid entity id"
POST /client/entities/{entity_id}:demote -> 400 error invalid_request "invalid entity id"
POST /client/entities/{entity_id}:patch -> 400 error invalid_request "invalid entity id"
POST /client/entities/{entity_id}:promote -> 400 error invalid_request "invalid entity id"
POST /client/entities:create -> 400 error invalid_request "invalid entity request body"
POST /client/grants/pending/{request_id}:approve -> 422 error projection_rejected "invalid grant approval body"
POST /client/grants/pending/{request_id}:deny -> 422 error projection_rejected "invalid grant denial body"
POST /client/grants/pending/{request_id}:narrow -> 422 error projection_rejected "invalid grant narrow body"
POST /client/grants/{grant_id}:revoke -> 503 error module_unavailable "provider not wired"
POST /client/messages -> 422 error projection_rejected "invalid message body"
POST /client/packs/{pack_id}:apply -> 400 error invalid_request "pack id must be name@version"
POST /client/packs/{pack_id}:uninstall -> 400 error invalid_request "pack id must be name@version"
POST /client/packs:install -> 400 error invalid_request "invalid pack request body"
POST /client/presets/{preset}:apply -> 422 error projection_rejected "invalid preset body"
POST /client/providers -> 400 error invalid_request "invalid provider request body"
POST /client/providers/{provider_id}:clear-key -> 404 error not_found "resource not found"
POST /client/providers/{provider_id}:delete -> 404 error not_found "resource not found"
POST /client/providers/{provider_id}:preflight -> 404 error not_found "resource not found"
POST /client/providers/{provider_id}:select -> 404 error not_found "resource not found"
POST /client/providers/{provider_id}:set-key -> 400 error invalid_request "invalid provider request body"
POST /client/providers/{provider_id}:sign-in -> 404 error not_found "resource not found"
POST /client/providers/{provider_id}:sign-in-cancel -> 404 error not_found "resource not found"
POST /client/providers/{provider_id}:sign-out -> 404 error not_found "resource not found"
POST /client/providers/{provider_id}:update -> 400 error invalid_request "empty provider update"
POST /client/runs/{run_id}:cancel -> 404 error not_found "resource not found"
POST /client/runs/{run_id}:pause -> 404 error not_found "resource not found"
POST /client/runs/{run_id}:resume -> 404 error not_found "resource not found"
POST /client/secrets:set-mode -> 400 error invalid_request "invalid secrets request body"
== transport-only routes (not in the route table)
GET / -> 200 content-type=text/html; charset=utf-8
GET /index.html -> 200 content-type=text/html; charset=utf-8
GET /app.js -> 200 content-type=text/javascript; charset=utf-8
GET /styles.css -> 200 content-type=text/css; charset=utf-8
GET /client/events/stream (WebSocket upgrade) -> not probed: needs a WebSocket handshake; the plain GET of this path is probed above
GET /client/llm/deltas/stream (WebSocket upgrade) -> not probed: needs a WebSocket handshake; the plain GET of this path is probed above
== session (last)
POST /client/session/refresh -> 200 data {csrf_token: null, expires_at: number, platform: string, principal: object, scopes: array, session_id: string, token: string}
POST /client/session/logout -> 200 data {revoked: bool}
