# MODULE-001-T111 (1) route table of the Client API composed in-process (RuntimeHostBuilder::new + wire_capabilities) on H1 (capabilities: fs, llm; deployed driver; no git repository)
# captured on the pre-lane OSS tree (main 678b7a77 = v0.1.26 + the sign-in retry fix + the workspace version bump after it, plus the read-only ClientApi::route_table accessor), before the runtime-compose move
# method path | exact/templated session mutation scopes
GET /client/agent-templates | exact session=true mutation=false scopes=[read_runs]
GET /client/agents | exact session=true mutation=false scopes=[read_runs]
POST /client/agents | exact session=true mutation=true scopes=[control_runs]
GET /client/agents/{agent_id} | templated session=true mutation=false scopes=[read_runs]
POST /client/agents/{agent_id}:delete | templated session=true mutation=true scopes=[control_runs]
POST /client/agents/{agent_id}:update | templated session=true mutation=true scopes=[control_runs]
GET /client/costs/agents | exact session=true mutation=false scopes=[read_runs]
GET /client/costs/agents/{agent_id} | templated session=true mutation=false scopes=[read_runs]
GET /client/costs/providers | exact session=true mutation=false scopes=[read_runs]
GET /client/costs/providers/{provider_id} | templated session=true mutation=false scopes=[read_runs]
GET /client/entities/{agent_id}/{entity_id} | templated session=true mutation=false scopes=[read_inventory]
POST /client/entities/{entity_id}:apply | templated session=true mutation=true scopes=[write_entities]
POST /client/entities/{entity_id}:demote | templated session=true mutation=true scopes=[write_entities]
POST /client/entities/{entity_id}:patch | templated session=true mutation=true scopes=[write_entities]
POST /client/entities/{entity_id}:promote | templated session=true mutation=true scopes=[write_entities]
POST /client/entities:create | exact session=true mutation=true scopes=[write_entities]
POST /client/entities:query | exact session=true mutation=false scopes=[read_inventory]
GET /client/events | exact session=true mutation=false scopes=[read_events]
GET /client/events/stream | exact session=true mutation=false scopes=[read_events]
GET /client/grants/pending | exact session=true mutation=false scopes=[approve_grants]
POST /client/grants/pending/{request_id}:approve | templated session=true mutation=true scopes=[approve_grants]
POST /client/grants/pending/{request_id}:deny | templated session=true mutation=true scopes=[approve_grants]
POST /client/grants/pending/{request_id}:narrow | templated session=true mutation=true scopes=[approve_grants]
POST /client/grants/{grant_id}:revoke | templated session=true mutation=true scopes=[approve_grants]
GET /client/health | exact session=false mutation=false scopes=[]
GET /client/llm/deltas/stream | exact session=true mutation=false scopes=[read_llm_deltas]
POST /client/messages | exact session=true mutation=true scopes=[send_messages]
GET /client/messages/{message_id} | templated session=true mutation=false scopes=[read_messages]
GET /client/packs | exact session=true mutation=false scopes=[read_inventory]
GET /client/packs/{pack_id} | templated session=true mutation=false scopes=[read_inventory]
POST /client/packs/{pack_id}:apply | templated session=true mutation=true scopes=[approve_grants]
POST /client/packs/{pack_id}:uninstall | templated session=true mutation=true scopes=[approve_grants]
POST /client/packs:install | exact session=true mutation=true scopes=[approve_grants]
POST /client/presets/{preset}:apply | templated session=true mutation=true scopes=[approve_grants]
GET /client/providers | exact session=true mutation=false scopes=[read_inventory]
POST /client/providers | exact session=true mutation=true scopes=[approve_grants]
GET /client/providers/{provider_id} | templated session=true mutation=false scopes=[read_inventory]
GET /client/providers/{provider_id}/sign-in | templated session=true mutation=false scopes=[read_inventory]
GET /client/providers/{provider_id}/usage | templated session=true mutation=false scopes=[read_inventory]
POST /client/providers/{provider_id}:clear-key | templated session=true mutation=true scopes=[approve_grants]
POST /client/providers/{provider_id}:delete | templated session=true mutation=true scopes=[approve_grants]
POST /client/providers/{provider_id}:preflight | templated session=true mutation=true scopes=[approve_grants]
POST /client/providers/{provider_id}:select | templated session=true mutation=true scopes=[approve_grants]
POST /client/providers/{provider_id}:set-key | templated session=true mutation=true scopes=[approve_grants]
POST /client/providers/{provider_id}:sign-in | templated session=true mutation=true scopes=[approve_grants]
POST /client/providers/{provider_id}:sign-in-cancel | templated session=true mutation=true scopes=[approve_grants]
POST /client/providers/{provider_id}:sign-out | templated session=true mutation=true scopes=[approve_grants]
